Table [table_name] {
  id bigint [pk, increment, note: 'Первичный ключ']
  created_at timestamp with time zone [not null, default: 'now()', note: 'Дата и время создания']
  updated_at timestamp with time zone [not null, default: 'now()', note: 'Дата и время последнего обновления']
}

Ref: idx_[table_name]_created_at < [table_name].created_at [name: idx_[table_name]_created_at, note: 'Индекс для фильтрации по дате создания']
